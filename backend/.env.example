# Server Port
PORT=5000

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=company_intro_db

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000

# Authentication (generate a unique secret of at least 32 characters)
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=8h
